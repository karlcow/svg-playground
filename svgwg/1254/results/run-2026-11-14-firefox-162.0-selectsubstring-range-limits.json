  "ctl_change": {
   "markup": "<svg width=\"120\" height=\"30\"><text x=\"5\" y=\"22\">hello</text></svg>",
   "script": "t.selectSubString(1, 3)",
   "expect_svg11": "ell",
   "expect_svg2_literal": "ell",
   "threw": null,
   "selected": "ell",
   "anchor": "#text \"hello\" @1",
   "focus": "#text \"hello\" @4",
   "direction": "forward",
   "ranges": 1,
   "verdict": "PASS"
  },
  "whole_word": {
   "markup": "<svg width=\"120\" height=\"30\"><text x=\"5\" y=\"22\">hello</text></svg>",
   "script": "t.selectSubString(0, 5)",
   "expect_svg11": "hello",
   "expect_svg2_literal": "IndexSizeError",
   "threw": null,
   "selected": "hello",
   "anchor": "#text \"hello\" @0",
   "focus": "#text \"hello\" @5",
   "direction": "forward",
   "ranges": 1,
   "verdict": "matches SVG 1.1"
  },
